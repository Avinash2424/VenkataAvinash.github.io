---
import certs from "@/data/certs.json";

const topSkills = [
  { name: "Ceph", color: "accent-green" },
  { name: "Golang", color: "accent-cyan" },
  { name: "Python", color: "accent-blue" },
  { name: "Kubernetes", color: "accent-purple" },
  { name: "Terraform", color: "accent-yellow" },
  { name: "OpenStack", color: "accent-red" },
];

const recentExperience = [
  {
    company: "ABAB Solutions Inc.",
    role: "Storage Infrastructure Operations & Automation Engineer",
    period: "July 2024 — Present",
    highlight: "Managing 11 Ceph clusters, 2,800+ OSDs at 99.99% availability",
    color: "accent-cyan",
  },
  {
    company: "Sharpwhiz Corp.",
    role: "Cloud Native Developer",
    period: "Jan 2024 – June 2024",
    highlight: "EKS deployments, Terraform automation, AWS Lambda workflows",
    color: "accent-blue",
  },
  {
    company: "Deloitte",
    role: "Cloud Native Developer",
    period: "Oct 2021 – July 2022",
    highlight: "Python REST APIs, AWS Step Functions, S3 migrations (+20% efficiency)",
    color: "accent-purple",
  },
];
---

<section class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section: Recent Experience Preview -->
    <div class="mb-20">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h2 class="mb-1 font-mono text-sm text-accent-green">$ tail -3 career.log</h2>
          <h3 class="text-2xl font-bold text-white">Recent Experience</h3>
        </div>
        <a
          href="/experience"
          class="hidden items-center gap-1 font-mono text-xs text-accent-green transition-colors hover:text-accent-green/80 sm:inline-flex"
        >
          View all
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="space-y-4">
        {recentExperience.map((exp) => (
          <a href="/experience" class="group block rounded-lg border border-panel-border bg-panel-light p-5 transition-all hover:border-accent-green/30">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h4 class="font-semibold text-white group-hover:text-accent-green">{exp.role}</h4>
                <p class={`font-mono text-sm text-${exp.color}`}>{exp.company}</p>
              </div>
              <span class="flex-shrink-0 rounded bg-panel px-2 py-0.5 font-mono text-xs text-gray-500">
                {exp.period}
              </span>
            </div>
            <p class="mt-2 text-sm text-gray-400">{exp.highlight}</p>
          </a>
        ))}
      </div>

      <a
        href="/experience"
        class="mt-4 inline-flex items-center gap-1 font-mono text-xs text-accent-green transition-colors hover:text-accent-green/80 sm:hidden"
      >
        View full experience →
      </a>
    </div>

    <!-- Section: Core Skills -->
    <div class="mb-20">
      <h2 class="mb-1 font-mono text-sm text-accent-green">$ echo $CORE_SKILLS</h2>
      <h3 class="mb-8 text-2xl font-bold text-white">Core Expertise</h3>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-6">
        {topSkills.map((skill) => (
          <div class={`rounded-lg border border-panel-border bg-panel-light p-4 text-center transition-all hover:border-${skill.color}/40`}>
            <p class={`font-mono text-sm font-semibold text-${skill.color}`}>{skill.name}</p>
          </div>
        ))}
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        {["Rook-Ceph", "Helm", "AWS", "GCP", "Azure", "Jenkins", "Grafana", "Perses", "Prometheus", "Splunk", "Docker", "Spring Boot", "Bash"].map((skill) => (
          <span class="rounded-full border border-panel-border bg-panel px-3 py-1 text-xs text-gray-400">{skill}</span>
        ))}
      </div>
    </div>

    <!-- Section: Certifications -->
    <div>
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h2 class="mb-1 font-mono text-sm text-accent-green">$ ls /etc/certs.d/</h2>
          <h3 class="text-2xl font-bold text-white">Certifications</h3>
        </div>
        <a
          href="/education"
          class="hidden items-center gap-1 font-mono text-xs text-accent-green transition-colors hover:text-accent-green/80 sm:inline-flex"
        >
          Education & Awards
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {certs.map((cert) => (
          <div class="flex items-center gap-3 rounded-lg border border-panel-border bg-panel-light p-4 transition-all hover:border-accent-green/30">
            <div
              class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg"
              style={`background-color: ${cert.badgeColor}20; border: 1px solid ${cert.badgeColor}40;`}
            >
              <span class="text-sm font-bold" style={`color: ${cert.badgeColor}`}>
                {cert.shortName.split(" ")[0].charAt(0)}{cert.shortName.split(" ").length > 1 ? cert.shortName.split(" ")[1].charAt(0) : ""}
              </span>
            </div>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-white">{cert.shortName}</p>
              <p class="text-xs text-gray-500">{cert.issuer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
