---
---

<section class="relative overflow-hidden py-24 md:py-32">
  <!-- Background grid effect -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2240%22 height=%2240%22><rect width=%2240%22 height=%2240%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>')"></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-12 md:grid-cols-5">
      <!-- Left column: text content -->
      <div class="md:col-span-3">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent-green/30 bg-accent-green/5 px-3 py-1">
          <span class="h-2 w-2 animate-pulse rounded-full bg-accent-green"></span>
          <span class="font-mono text-xs text-accent-green">Available for opportunities</span>
        </div>

        <h1 class="mb-4 text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
          Venkata Avinash<br />
          <span class="text-accent-green">Addagada</span>
        </h1>

        <p class="mb-2 font-mono text-lg text-accent-cyan">
          Storage Infrastructure & Automation Engineer
        </p>

        <p class="mb-8 max-w-xl leading-relaxed text-gray-400">
          Specialist in managing high-scale Ceph and OpenStack storage environments
          with 11 clusters and 2,800+ OSDs at 99.99% availability. I build automation
          in Go and Python that eliminates manual toil and modernizes infrastructure operations.
        </p>

        <!-- Quick stats inline -->
        <div class="mb-8 flex flex-wrap gap-6">
          <div>
            <p class="text-2xl font-bold text-accent-green">5+</p>
            <p class="text-xs text-gray-500">Years Experience</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-accent-blue">5</p>
            <p class="text-xs text-gray-500">Cloud Certifications</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-accent-cyan">2,800+</p>
            <p class="text-xs text-gray-500">OSDs Managed</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-accent-yellow">11</p>
            <p class="text-xs text-gray-500">Ceph Clusters</p>
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4">
          <a
            href="/experience"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-green px-5 py-2.5 font-mono text-sm font-semibold text-panel transition-all hover:bg-accent-green/90"
          >
            View Experience
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-lg border border-panel-border px-5 py-2.5 font-mono text-sm text-gray-300 transition-all hover:border-accent-green/40 hover:text-white"
          >
            Get in Touch
          </a>
        </div>
      </div>

      <!-- Right column: terminal card -->
      <div class="md:col-span-2">
        <div class="rounded-lg border border-panel-border bg-panel-light p-5">
          <div class="mb-4 flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-accent-red"></span>
            <span class="h-3 w-3 rounded-full bg-accent-yellow"></span>
            <span class="h-3 w-3 rounded-full bg-accent-green"></span>
            <span class="ml-4 font-mono text-xs text-gray-500">whoami.sh</span>
          </div>
          <div class="space-y-2 font-mono text-xs">
            <p><span class="text-accent-green">$</span> <span class="text-gray-400">cat /etc/profile</span></p>
            <p class="text-gray-500">---</p>
            <p><span class="text-accent-cyan">role:</span> <span class="text-gray-300">Storage & Cloud Infra Engineer</span></p>
            <p><span class="text-accent-cyan">employer:</span> <span class="text-gray-300">ABAB Solutions Inc.</span></p>
            <p><span class="text-accent-cyan">location:</span> <span class="text-gray-300">Tampa, FL</span></p>
            <p><span class="text-accent-cyan">education:</span> <span class="text-gray-300">MS CS, Texas Tech</span></p>
            <p class="text-gray-500">---</p>
            <p><span class="text-accent-green">$</span> <span class="text-gray-400">cat skills.yml</span></p>
            <p><span class="text-accent-yellow">storage:</span> <span class="text-gray-300">Ceph, Rook, OpenStack, Swift</span></p>
            <p><span class="text-accent-yellow">languages:</span> <span class="text-gray-300">Go, Python, Bash, Java</span></p>
            <p><span class="text-accent-yellow">infra:</span> <span class="text-gray-300">K8s, Helm, Terraform</span></p>
            <p><span class="text-accent-yellow">observe:</span> <span class="text-gray-300">Grafana, Perses, Prometheus</span></p>
            <p class="text-gray-500">---</p>
            <p><span class="text-accent-green">$</span> <span class="animate-pulse text-gray-400">_</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
