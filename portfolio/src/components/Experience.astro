---
const experiences = [
  {
    company: "ABAB Solutions Inc.",
    role: "Storage Infrastructure Operations & Automation Engineer",
    period: "July 2024 — Present",
    location: "Tampa, FL",
    color: "accent-cyan",
    bullets: [
      "Manage a global storage footprint of 11 Ceph clusters with over 2,800 OSDs, ensuring 99.99% availability.",
      "Develop Golang-based automation for critical cluster management, including automated decommissioning of storage nodes to eliminate manual error.",
      "Architect Python-based frameworks using Pandas to analyze ServiceNow incident data and filter telemetry noise from Grafana and Perses.",
      "Lead technical initiatives to implement agentic development and MCP servers, standardizing storage troubleshooting and on-call workflows.",
      "Execute complex Rook-Ceph orchestration via Helm, including multi-region capacity rebalancing and HDD pool reallocations.",
      "Deployed Kubernetes clusters using Helm charts and Terraform; engineered Jenkins CI/CD pipelines for production environments.",
      "Implemented Monitoring-as-Code and ELK logging infrastructure, designing SLO-based alerting in Splunk and Grafana to reduce incident MTTR.",
      "Enforced RBAC policies and secure secrets management within Kubernetes to maintain secure-by-default standards for high-volume data clusters.",
    ],
  },
  {
    company: "Sharpwhiz Corp.",
    role: "Cloud Native Developer",
    period: "January 2024 – June 2024",
    location: "Remote",
    color: "accent-blue",
    bullets: [
      "Orchestrated Amazon EKS deployments and utilized Terraform to configure AWS Batch for high-volume data processing.",
      "Developed AWS Lambda functions to automate storage job scheduling and workflow orchestration with S3 and SQS.",
    ],
  },
  {
    company: "Deloitte",
    role: "Cloud Native Developer",
    period: "October 2021 – July 2022",
    location: "Hyderabad, India",
    color: "accent-green",
    bullets: [
      "Built Python REST APIs and AWS Step Functions to automate the migration of large-scale On-Premises XML files to AWS S3 storage.",
      "Utilized AWS Boto3 SDK to optimize interaction with storage services, improving migration efficiency by 20%.",
    ],
  },
  {
    company: "Accenture",
    role: "Application Development Analyst",
    period: "June 2021 – October 2021",
    location: "Bangalore, India",
    color: "accent-yellow",
    bullets: [
      "Managed ETL pipelines across AWS, Azure, and GCP, empowering users to manage 40% more storage-related data tasks.",
      "Applied Factory design patterns in Python to simplify code interaction with diverse Cloud Storage Providers.",
    ],
  },
  {
    company: "Cognizant",
    role: "Cloud Native Developer (Intern to Full-time)",
    period: "January 2019 – June 2021",
    location: "Chennai, India",
    color: "accent-red",
    bullets: [
      "Automated server patching and vulnerability detection using AWS Lambda, reducing operational workload by 40%.",
      "Developed Java/Spring Boot APIs for storage-heavy transaction processing, tripling batch processing capabilities.",
    ],
  },
];
---

<section id="experience" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="mb-2 font-mono text-sm text-accent-green">$ cat experience.log</h2>
    <h3 class="mb-12 text-3xl font-bold text-white">Work Experience</h3>

    <!-- Vertical timeline -->
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-4 top-0 h-full w-px bg-panel-border md:left-1/2"></div>

      {experiences.map((exp, i) => (
        <div class={`relative mb-12 flex flex-col md:flex-row ${i % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"}`}>
          {/* Dot on timeline */}
          <div class="absolute left-4 top-6 z-10 h-3 w-3 -translate-x-1/2 rounded-full border-2 border-panel bg-accent-green md:left-1/2"></div>

          {/* Spacer */}
          <div class="hidden w-1/2 md:block"></div>

          {/* Content card */}
          <div class={`ml-10 w-full rounded-lg border border-panel-border bg-panel-light p-6 md:ml-0 md:w-1/2 ${i % 2 === 0 ? "md:ml-8" : "md:mr-8"}`}>
            <div class="mb-3 flex flex-wrap items-center gap-3">
              <span class={`rounded bg-panel px-2 py-0.5 font-mono text-xs text-${exp.color}`}>
                {exp.period}
              </span>
              <span class="text-xs text-gray-500">{exp.location}</span>
            </div>
            <h4 class="text-lg font-bold text-white">{exp.role}</h4>
            <p class={`mb-4 font-mono text-sm text-${exp.color}`}>{exp.company}</p>
            <ul class="space-y-2">
              {exp.bullets.map((bullet) => (
                <li class="flex gap-2 text-sm text-gray-400">
                  <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-panel-border"></span>
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
