---
const skillCategories = [
  {
    title: "Storage & Cloud",
    color: "accent-green",
    skills: ["Ceph (Squid, Rook)", "OpenStack", "Swift", "AWS", "Azure", "GCP"],
  },
  {
    title: "Programming",
    color: "accent-blue",
    skills: ["Python", "Golang", "Bash", "Java (Spring Boot)"],
  },
  {
    title: "Infrastructure",
    color: "accent-cyan",
    skills: ["Kubernetes (EKS, AKS)", "Helm", "Terraform", "CloudFormation"],
  },
  {
    title: "Observability",
    color: "accent-red",
    skills: ["Grafana", "Perses", "Prometheus", "Splunk", "Dynatrace", "ServiceNow"],
  },
  {
    title: "CI/CD & Automation",
    color: "accent-yellow",
    skills: ["Jenkins", "GitHub Actions", "AWS CodePipeline"],
  },
  {
    title: "Databases & Frameworks",
    color: "accent-purple",
    skills: ["PostgreSQL", "MySQL", "DynamoDB", "Flask", "Spring Boot", "Spring Batch"],
  },
];
---

<section id="skills" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="mb-2 font-mono text-sm text-accent-green">$ neofetch --skills</h2>
    <h3 class="mb-12 text-3xl font-bold text-white">Skills</h3>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {skillCategories.map((cat) => (
        <div class="rounded-lg border border-panel-border bg-panel-light p-5">
          <h4 class={`mb-3 font-mono text-xs font-semibold text-${cat.color}`}>
            {cat.title}
          </h4>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="rounded-full border border-panel-border bg-panel px-2.5 py-1 text-xs text-gray-300">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
